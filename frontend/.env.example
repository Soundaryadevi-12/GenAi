# Frontend Environment Variables
# Copy this file to .env.local and fill in values

# Backend API base URL — set to the backend ORIGIN only (no trailing /api).
# All /api/* prefixes are already included in each API call in src/services/api.js.
# Leave blank for Vite dev server (proxy forwards /api/* to localhost:8000 automatically).
#
# Local development (direct, bypasses Vite proxy):
# VITE_API_BASE_URL=http://localhost:8000
#
# Vercel / production:
# VITE_API_BASE_URL=https://your-backend.vercel.app
VITE_API_BASE_URL=
